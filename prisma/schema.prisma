// prisma/schema.prisma
// NexCal v3.0 — Multi-Tenant SaaS Booking Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  PLATFORM_ADMIN
  TENANT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// ============================================================
// MODEL: User
// ============================================================
// PLATFORM_ADMIN: can create/manage tenant accounts, monitor the platform
// TENANT: one business — fully isolated from other tenants
model User {
  id             String    @id @default(cuid())
  username       String    @unique  // URL slug → /[username]
  email          String    @unique
  hashedPassword String    @map("hashed_password")
  name           String
  role           Role      @default(TENANT)

  // Business profile (TENANT only)
  businessName   String?   @map("business_name")
  businessLogo   String?   @map("business_logo")
  timezone       String    @default("UTC")  // IANA: "Asia/Jakarta"
  isActive       Boolean   @default(true)   @map("is_active")
  globalBreaks   Json      @default("[]")   @map("global_breaks")
  embedViews     Int       @default(0)      @map("embed_views")

  createdAt      DateTime  @default(now())  @map("created_at")
  updatedAt      DateTime  @updatedAt       @map("updated_at")

  // Relations
  eventTypes        EventType[]
  schedules         Schedule[]
  availabilitySchedules AvailabilitySchedule[]
  dateOverrides     DateOverride[]
  bookings          Booking[]
  webhookEndpoints  WebhookEndpoint[]
  actorAuditLogs    AuditLog[]        @relation("ActorLogs")
  targetAuditLogs   AuditLog[]        @relation("TargetLogs")
  errorLogs         ErrorLog[]

  @@map("users")
}

// ============================================================
// MODEL: AvailabilitySchedule
// ============================================================
// Represents a named weekly availability schedule (e.g. "Default", "Weekend Only")
model AvailabilitySchedule {
  id         String      @id @default(cuid())
  name       String
  isDefault  Boolean     @default(false) @map("is_default")

  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules  Schedule[]
  eventTypes EventType[]

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("availability_schedules")
}

// ============================================================
// MODEL: EventType
// ============================================================
// Defines a bookable event (e.g., "30-min Demo", "1hr Consultation")
// Custom booking form fields are stored as a JSON array
model EventType {
  id               String    @id @default(cuid())
  slug             String    // URL: /[username]/[slug]
  name             String
  description      String?
  duration         Int       // minutes
  bufferTime       Int       @default(0)    @map("buffer_time")
  color            String?   // hex color for UI
  isActive         Boolean   @default(true) @map("is_active")
  // JSON array of field definitions:
  // [{ id: string, label: string, type: "text"|"email"|"phone"|"textarea"|"select", required: boolean, options?: string[] }]
  customFields     Json      @default("[]") @map("custom_fields")
  maxBookingsPerDay Int?     @map("max_bookings_per_day")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")

  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings         Booking[]

  availabilityScheduleId String? @map("availability_schedule_id")
  availabilitySchedule   AvailabilitySchedule? @relation(fields: [availabilityScheduleId], references: [id], onDelete: SetNull)

  @@unique([userId, slug])
  @@map("event_types")
}

// ============================================================
// MODEL: Schedule
// ============================================================
// Weekly availability. startTime/endTime stored in tenant's timezone as "HH:mm".
model Schedule {
  id        String  @id @default(cuid())
  dayOfWeek Int     @map("day_of_week")  // 0=Sun, 1=Mon, ..., 6=Sat
  startTime String  @map("start_time")   // "HH:mm" in tenant's timezone
  endTime   String  @map("end_time")     // "HH:mm" in tenant's timezone
  isActive  Boolean @default(true)       @map("is_active")

  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  availabilityScheduleId String? @map("availability_schedule_id")
  availabilitySchedule   AvailabilitySchedule? @relation(fields: [availabilityScheduleId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@map("schedules")
}

// ============================================================
// MODEL: DateOverride
// ============================================================
model DateOverride {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  isBlocked Boolean  @default(true)  @map("is_blocked")
  startTime String?  @map("start_time")
  endTime   String?  @map("end_time")
  reason    String?

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("date_overrides")
}

// ============================================================
// MODEL: Booking
// ============================================================
// All times stored in UTC. Conversion happens at UI layer.
model Booking {
  id              String        @id @default(cuid())
  status          BookingStatus @default(PENDING)
  startTime       DateTime      @map("start_time")   // UTC
  endTime         DateTime      @map("end_time")      // UTC

  // Core customer fields
  customerName    String        @map("customer_name")
  customerEmail   String?       @map("customer_email")
  customerPhone   String?       @map("customer_phone")
  // Values for dynamic custom fields keyed by field id
  customFieldData Json          @default("{}") @map("custom_field_data")

  cancelReason    String?       @map("cancel_reason")
  managementToken String        @unique @default(uuid()) @map("management_token")
  rescheduleCount Int           @default(0)  @map("reschedule_count")
  notes           String?       // internal notes added by tenant

  userId          String        @map("user_id")       // which tenant owns this booking
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventTypeId     String        @map("event_type_id")
  eventType       EventType     @relation(fields: [eventTypeId], references: [id])
  webhookDeliveries WebhookDelivery[]

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt      @map("updated_at")

  @@index([userId, startTime, status])
  @@map("bookings")
}

// ============================================================
// MODEL: WebhookEndpoint
// ============================================================
model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secret    String?  // HMAC-SHA256 signing secret (auto-generated)
  // Subscribed events: BOOKING_CREATED | BOOKING_RESCHEDULED | BOOKING_CANCELLED | BOOKING_COMPLETED | BOOKING_NO_SHOW
  events    String[]
  isActive  Boolean  @default(true) @map("is_active")

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("webhook_endpoints")
}

// ============================================================
// MODEL: WebhookDelivery
// ============================================================
// Logs every delivery attempt for observability and retry
model WebhookDelivery {
  id            String    @id @default(cuid())
  event         String    // e.g. "BOOKING_CREATED"
  payload       Json
  status        String    @default("PENDING")  // PENDING | SUCCESS | FAILED
  attempts      Int       @default(0)
  nextRetryAt   DateTime? @map("next_retry_at")
  lastAttemptAt DateTime? @map("last_attempt_at")
  responseCode  Int?      @map("response_code")
  responseBody  String?   @map("response_body")
  error         String?

  webhookId     String    @map("webhook_id")
  webhook       WebhookEndpoint @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  bookingId     String?   @map("booking_id")
  booking       Booking?  @relation(fields: [bookingId], references: [id])

  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

// ============================================================
// MODEL: AuditLog
// ============================================================
// Records all significant platform actions for admin monitoring
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // "USER_CREATED" | "USER_DEACTIVATED" | "BOOKING_CANCELLED" | "WEBHOOK_FAILED" ...
  actorId   String?  @map("actor_id")   // who performed the action
  actor     User?    @relation("ActorLogs",  fields: [actorId],  references: [id], onDelete: SetNull)
  targetId  String?  @map("target_id")  // who was affected (e.g. tenant being edited)
  target    User?    @relation("TargetLogs", fields: [targetId], references: [id], onDelete: SetNull)
  metadata  Json     @default("{}")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("audit_logs")
}

// ============================================================
// MODEL: ErrorLog
// ============================================================
model ErrorLog {
  id         String   @id @default(cuid())
  message    String
  stack      String?
  path       String?
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  component  String   // "CLIENT" | "SERVER" | "API"
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("error_logs")
}

// ============================================================
// MODEL: SystemSetting
// ============================================================
model SystemSetting {
  key   String @id
  value String

  @@map("system_settings")
}
